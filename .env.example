# =============================================================================
# Fahem - example environment
# Copy to .env:  cp .env.example .env
#
# The stack runs END TO END with NO real credentials: leave OPENAI_API_KEY empty
# and the app uses the deterministic offline LLM/embedding provider so the agent
# graph, RAG, tools and MCP are all still exercised. Set a real key to switch to
# GPT models (see LLM_PROVIDER below).
# =============================================================================

# --- Application -------------------------------------------------------------
APP_NAME=fahem
ENVIRONMENT=local                 # local | staging | production
DEBUG=true
LOG_LEVEL=INFO
LOG_FORMAT=console                # console | json  (use json in production)
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- Database ----------------------------------------------------------------
# Hostname "postgres" is the docker-compose service. Use localhost outside Docker.
DATABASE_URL=postgresql+psycopg://research:research@postgres:5432/research
# Least-privilege, read-only role used by the SQL/text-to-SQL tool layer.
DATABASE_READONLY_URL=postgresql+psycopg://research_ro:research_ro@postgres:5432/research
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_ECHO=false

# --- Redis -------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CACHE_TTL_SECONDS=900

# --- Authentication ----------------------------------------------------------
# CHANGE THIS. In AWS it is injected from Secrets Manager, never baked in.
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# --- LLM ---------------------------------------------------------------------
# auto  -> openai when OPENAI_API_KEY is set, otherwise the offline fake
# openai-> always OpenAI (fails fast without a key)
# fake  -> always the deterministic offline provider
LLM_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_BASE_URL=
LLM_REASONING_MODEL=gpt-5             # planning, synthesis, verification
LLM_FAST_MODEL=gpt-5-mini             # classification, routing, extraction
LLM_JUDGE_MODEL=gpt-5                 # LLM-as-a-judge in evaluation
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3
LLM_TEMPERATURE=0.1

# --- Embeddings --------------------------------------------------------------
EMBEDDING_MODEL=text-embedding-3-large
# 3072 is the native size of text-embedding-3-large, but pgvector's HNSW index
# tops out at 2000 dims for the `vector` type, so we request a shortened
# (Matryoshka) embedding. See README > RAG architecture.
EMBEDDING_DIM=1536
EMBEDDING_BATCH_SIZE=64

# --- Retrieval ---------------------------------------------------------------
RAG_TOP_K=8
RAG_CANDIDATE_K=24                 # fetched before reranking
# Similarity floor. This is MODEL-DEPENDENT: cosine scores from
# text-embedding-3-large and from the offline hashing provider have completely
# different distributions, so a threshold tuned for one silently discards valid
# hits from the other. Keep it low and let top-K plus reranking do the work;
# tune it from evaluation data, not intuition.
RAG_MIN_SIMILARITY=0.05
RERANKER_PROVIDER=none             # none | cohere
COHERE_API_KEY=

# --- Agent bounds ------------------------------------------------------------
MAX_AGENT_ITERATIONS=3
MAX_TOOL_CALLS=8
MAX_RUNTIME_SECONDS=90
AGENT_REQUIRE_APPROVAL_FOR_SENSITIVE=true

# --- Document ingestion ------------------------------------------------------
CHUNK_SIZE_TOKENS=550
CHUNK_OVERLAP_TOKENS=80
MAX_UPLOAD_MB=25
ALLOWED_UPLOAD_TYPES=["application/pdf"]

# --- Object storage ----------------------------------------------------------
# local -> ./storage on disk (default, no AWS needed).  s3 -> real S3/MinIO.
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=/app/storage
S3_BUCKET=fahem-documents
S3_ENDPOINT_URL=
AWS_REGION=eu-west-1

# --- External services -------------------------------------------------------
CLINICAL_TRIALS_API_URL=http://mock-clinical-api:8001
CLINICAL_TRIALS_API_KEY=demo-clinical-api-key
EXTERNAL_HTTP_TIMEOUT_SECONDS=10
EXTERNAL_HTTP_MAX_RETRIES=3

# --- MCP ---------------------------------------------------------------------
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8020
MCP_SERVER_URL=http://mcp:8020/mcp
MCP_AUTH_TOKEN=dev-only-mcp-token-change-me
MCP_ENABLED=true
# Host header allowlist for the MCP server's DNS-rebinding protection. Add the
# hostname every client uses to reach it, or requests come back 421.
MCP_ALLOWED_HOSTS=["localhost:8020","127.0.0.1:8020","mcp:8020"]

# --- Rate limiting -----------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
AGENT_RATE_LIMIT_REQUESTS=10
AGENT_RATE_LIMIT_WINDOW_SECONDS=60

# --- Observability -----------------------------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=fahem
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Seed / demo accounts (local only) ---------------------------------------
SEED_DEFAULT_PASSWORD=Research123!
